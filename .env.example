# ---------- Frontend (Vercel project env vars / frontend/.env.local) ----------
# Public URL of the Vultr backend. Leave empty for local dev (Vite proxies /api to :8000).
VITE_API_BASE_URL=http://YOUR_VULTR_IP:8000

# ---------- Backend (export on the Vultr box, or put in backend/.env and `set -a; . ./.env`) ----------
# Comma-separated browser origins allowed to call the API.
SIFT_CORS_ORIGINS=https://your-sift.vercel.app,http://localhost:5173
# Optional regex to also allow Vercel preview deployments.
SIFT_CORS_REGEX=https://.*-your-team\.vercel\.app
# Required to use POST /api/search/index (sent as the X-Admin-Token header).
SIFT_ADMIN_TOKEN=change-me
# Optional overrides
# SIFT_DATA_DIR=/opt/sift/backend/data
# SIFT_CLIP_MODEL=ViT-B-32
# SIFT_CLIP_PRETRAINED=laion2b_s34b_b79k
# Optional explanation provider (none built in; templates are used).
# SIFT_EXPLAIN_PROVIDER=
