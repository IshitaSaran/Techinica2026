# ---------- Frontend (Vercel project env vars / frontend/.env.local) ----------
# Public HTTPS URL of the Vultr backend, no trailing slash (Vercel pages can't call plain http).
# Leave empty for local dev (Vite proxies /api to :8000).
VITE_API_BASE_URL=https://YOUR-VULTR-IP-WITH-DASHES.sslip.io

# ---------- Backend (export on the Vultr box, or put in backend/.env and `set -a; . ./.env`) ----------
# Comma-separated exact browser origins allowed to call the API.
# Default if unset: http://localhost:5173,http://127.0.0.1:5173
SIFT_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173
# Regex for extra allowed origins (fullmatched). Same as the default in backend/main.py:
# any https://*.vercel.app, covering production and preview deploys. Set empty to disable.
SIFT_CORS_REGEX=https://.*\.vercel\.app
# Required to use POST /api/search/index (sent as the X-Admin-Token header).
SIFT_ADMIN_TOKEN=change-me
# Optional overrides
# SIFT_DATA_DIR=/opt/sift/backend/data
# SIFT_CLIP_MODEL=ViT-B-32
# SIFT_CLIP_PRETRAINED=laion2b_s34b_b79k
# Optional explanation provider (none built in; templates are used).
# SIFT_EXPLAIN_PROVIDER=
